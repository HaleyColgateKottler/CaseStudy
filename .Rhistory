" =~ temperature + heartrate + resprate + o2sat + sbp + dbp + acuity + disposition",
collapse = "\n"),
paste0("h", 1:k, "~ 0*1", sep = "", collapse = "\n"),
paste0(h.vars,
" ~ anchor_age + gender + medicaidMedicare +
marital_statusMARRIED +
raceasian + raceblack + raceother + racehispanic.or.latino",
sep = "", collapse = "\n"),
'anchor_age ~ 0*1',
'temperature ~ 0*1',
'heartrate ~ 0*1',
'resprate ~ 0*1',
'o2sat ~ 0*1',
'sbp ~ 0*1',
'dbp ~ 0*1',
'treatment_time ~ 0*1',
sep = "\n")
fit <- tryCatch(
{
sem(model, data = full_df, rotation = "varimax")
},
error = function(e) {
print(e)
new_NullSEM(0)
}
)
if (inspect(fit, "converged")) {
fits <- c(fits, fit)
AICs <- c(AICs, AIC(fit))
k.keeps <- c(k.keeps, k)
}
}
fit <- fits[[which(AICs == min(AICs))]]
pars <- parameterEstimates(fit)
params = inspect(fit, what = 'est')
parameters <- list(
lambda.est = params$lambda,
psi.est = params$theta,
sigma.est = params$psi,
nu.est = params$nu,
acuity.threshold <- params$tau,
gamma.est <- params$gamma,
cov.x <- params$cov.x,
mean.x <- params$mean.x,
k = ncol(lambda.est)
)
lavInspect(fit)
View(params)
parameters <- list(
lambda.est = params$lambda)
parameters <- list(
lambda.est = params$lambda,
psi.est = params$theta)
sigma.est = params$psi
View(parameters)
parameters$psi.est
params$lambda
k = 6
)
parameters <- list(
lambda.est = params$lambda[1:8, 1:6],
psi.est = params$theta)
parameters$lambda.est
params$theta
View(params)
summary(full_df)
parameters <- list(
lambda.est = params$lambda[1:8, 1:6],
psi.est = params$theta[1:8, 1:8])
params$psi
k = k.keeps[which(AICs == min(AICs))]
params$psi
params$beta
parameters <- list(
lambda.est = params$lambda[1:8, 1:6],
psi.est = params$theta[1:8, 1:8],
sigma.est = params$psi,
nu.est = params$nu,
covs.est = params$beta[(k+1):ncol(params$beta), 1:k]
)
params$nu
params$alpha
parameters <- list(
lambda.est = params$lambda[1:8, 1:6],
psi.est = params$theta[1:8, 1:8],
sigma.est = params$psi,
nu.est = params$nu,
covs.est = params$beta[(k+1):ncol(params$beta), 1:k],
covmeans.est = params$alpha[(k+1):nrow(params$alpha)]
)
View(parameters)
View(pars)
parameters$lambda.est
parameters$psi.est
parameters$sigma.est
parameters$nu.est
parameters$covmeans.est
parameters$covs.est
params$beta
parameters <- list(
lambda.est = params$lambda[1:8, 1:6],
psi.est = params$theta[1:8, 1:8],
sigma.est = params$psi,
nu.est = params$nu,
covs.est = params$beta[1:k, (k+1):ncol(params$beta)],
covmeans.est = params$alpha[(k+1):nrow(params$alpha)]
)
parameters$covs.est
source("latentMethod.R")
new_NullSEM <- function(x = double(), convergence = FALSE) {
stopifnot(is.double(x))
structure(x,
class = "NullSEM",
converged = convergence
)
}
inspect.NullSEM <- function(x, what) {
attr(x, what)
}
library(caret)
library(lavaan)
df <- read.csv('full_data.csv')
covariates <- c('gender', 'anchor_age', 'race', 'insurance', 'marital_status')
outcome <- c('readmit')
treatment <- c('disposition')
proxies <- c('temperature', 'heartrate', 'resprate', 'o2sat', 'sbp', 'dbp',
'acuity', 'treatment_time')
colnames(df)
dummy <- dummyVars(" ~ race + insurance + marital_status", data=df)
new_df <- data.frame(predict(dummy, newdata=df))
covariates <- c('anchor_age', 'gender',
colnames(new_df))
full_df <- cbind(df[,c('anchor_age', 'readmit', proxies)], new_df)
full_df$disposition <- ifelse(df$disposition == "ADMITTED", 1, 0)
full_df$gender <- ifelse(df$gender == 'F', 1, 0)
full_df$raceother <- full_df$raceother + full_df$raceamerican.indian.or.alaska.native
full_df <- full_df[full_df$insuranceMissing != 1, ]
full_df <- full_df[full_df$raceunknown != 1, ]
full_df <- full_df[full_df$marital_statusMissing != 1, ]
to.scale <- c('anchor_age', 'temperature', 'heartrate', 'resprate', 'o2sat',
'sbp', 'dbp', 'treatment_time')
scale.means <- colMeans(full_df[,to.scale])
full_df[,to.scale] <- data.frame(t(apply(full_df[,to.scale], 1, function(row){row - scale.means})))
scale.vars <- sqrt(apply(full_df[,to.scale], 2, var))
full_df[,to.scale] <- data.frame(t(apply(full_df[,to.scale], 1, function(row){row/scale.vars})))
# factor analysis with covariates
kvals <- 1:8
z.vars <- c(proxies, 'disposition')
covariates <- c('marital_statusMARRIED', 'marital_statusDIVORCED',
'marital_statusWIDOWED',
'raceasian',
'raceblack', 'raceother',
'racehispanic.or.latino', 'anchor_age',
'medicaidMedicare',
'gender')
full_df$medicaidMedicare <- full_df$insuranceMedicaid + full_df$insuranceMedicare
full_df <- full_df[, !(colnames(full_df) %in%
c('insuranceMedicaid', 'insuranceMedicare', 'insuranceOther',
'raceamerican.indian.or.alaska.native', 'raceunknown',
'insuranceMissing', 'marital_statusMissing'))]
library(car)
library(corrplot)
corm <- cor(full_df[,covariates])
corrplot(corm, number.digits = 1, method = 'number')
eigen(corm)$values
# covariates <- covariates[!(covariates  %in% c('insuranceMedicare',
# 'racewhite'))]
m1 <- lm(paste('readmit ~', paste0(covariates, collapse = " + ")), full_df)
vif <- vif(m1)
vif
